.{
    .name = .ziggurat,
    .version = "0.0.1",
    // Generated by `zig init`; never changes. Changing it has security and
    // trust implications (it is how a package is identified across versions).
    .fingerprint = 0x5865ccebd41e7218,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    // Only tracked paths: a generated dir (zig-out, .zig-cache) must not be
    // listed, or a fresh clone and a working tree hash differently.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "scripts",
        "LICENSE",
        "README.md",
    },
}
